<div class="field">
  <%= f.label :username %><br>
  <%= f.text_field :username, required: true %>
</div>

<div class="field">
  <%= f.label :full_name %><br>
  <%= f.text_field :full_name %>
</div>

<div class="field">
  <%= f.label :address %><br>
  <%= f.text_area :address %>
</div>

<div class="field">
  <%= f.label :city %><br>
  <%= f.text_field :city %>
</div>

<div class="field">
  <%= f.label :postal_code %><br>
  <%= f.text_field :postal_code %>
</div>

<div class="field">
  <%= f.label :province_id, "Province" %><br>
  <%= f.collection_select :province_id,
      Province.order(:name), :id, :name,
      { prompt: "Select Province" } %>
</div>

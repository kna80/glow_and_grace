
<div style="max-width: 900px; margin: 40px auto; padding: 35px; background: #fff5f8; border-radius: 15px; text-align: center;">

  <% if @product.image.attached? %>
    <%= image_tag @product.image.variant(resize_to_limit: [800, 800]),
        alt: @product.name,
        style: "width: 100%; max-width: 450px; border-radius: 12px;" %>
  <% else %>
    <p>No Image Available</p>
  <% end %>

  <h1 style="color: #a30d50;">
    <%= @product.name %>
  </h1>

  <p><%= @product.description %></p>

  <h2 style="color: #a30d50;">
    <%= number_to_currency(@product.price) %>
  </h2>

  <p>Category: <%= @product.category.name %></p>

  <p>Available Stock: <%= @product.stock_quantity %></p>

<% if @product.stock_quantity > 0 %>

  <%= form_with url: add_to_cart_path, method: :post do |form| %>

    <%= form.hidden_field :product_id, value: @product.id %>

    <%= form.label :quantity, "Quantity:" %>

    <%= form.number_field :quantity,
                          value: 1,
                          min: 1,
                          max: @product.stock_quantity,
                          style: "width: 70px; padding: 10px; margin: 15px;" %>

    <%= form.submit "🛍️ Add to Cart",
                    style: "background: #a30d50; color: white;
                            padding: 14px 28px; border: none;
                            border-radius: 25px; cursor: pointer;
                            font-weight: bold;" %>

  <% end %>

<% end %>
  <br><br>

  <%= link_to "Back to All Products", products_path,
      style: "color: #a30d50; font-weight: bold;" %>

</div>

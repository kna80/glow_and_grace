<style>
  .category-page {
    min-height: 100vh;
    background: #fff6fa;
    padding: 55px 8%;
    font-family: Arial, sans-serif;
  }

  .category-header {
    text-align: center;
    margin-bottom: 45px;
  }

  .category-header h1 {
    font-size: 42px;
    color: #861b4c;
    margin-bottom: 15px;
  }

  .category-header p {
    font-size: 18px;
    color: #533044;
  }

  .back-link {
    display: inline-block;
    margin-bottom: 30px;
    color: #98134e;
    font-weight: bold;
    text-decoration: none;
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 25px;
  }

  .product-card {
    background: white;
    border: 1px solid #f4cddd;
    border-radius: 18px;
    padding: 30px;
    text-align: center;
    box-shadow: 0 8px 25px rgba(130, 25, 70, 0.08);
    transition: transform 0.3s;
  }

  .product-card:hover {
    transform: translateY(-5px);
  }

  .product-card h3 {
    color: #861b4c;
    font-size: 22px;
  }

  .product-description {
    color: #51404a;
    line-height: 1.6;
  }

  .product-price {
    color: #861b4c;
    font-size: 24px;
    font-weight: bold;
    margin: 20px 0;
  }

  .view-button {
    display: inline-block;
    background: #98134e;
    color: white;
    padding: 12px 25px;
    border-radius: 25px;
    text-decoration: none;
    font-weight: bold;
  }

  .view-button:hover {
    background: #700d38;
  }

  .empty-message {
    text-align: center;
    font-size: 20px;
    color: #861b4c;
  }
</style>

<div class="category-page">

  <%= link_to "← Back to All Products", root_path, class: "back-link" %>

  <div class="category-header">
    <h1><%= @category.name %> 💗</h1>

    <p><%= @category.description %></p>

    <p>
      Discover our beautiful collection of
      <%= @category.name.downcase %> products.
    </p>
  </div>

  <% if @products.any? %>

    <div class="products-grid">

      <% @products.each do |product| %>

        <div class="product-card">

          <h3><%= product.name %></h3>

          <p class="product-description">
            <%= truncate(product.description, length: 110) %>
          </p>

          <div class="product-price">
            <%= number_to_currency(product.price) %>
          </div>

          <p>
            <% if product.stock_quantity > 0 %>
              <span style="color: green;">In Stock</span>
            <% else %>
              <span style="color: #a01845;">Out of Stock</span>
            <% end %>
          </p>

          <%= link_to "View Details",
              product_path(product),
              class: "view-button" %>

        </div>

      <% end %>

    </div>

  <% else %>

    <p class="empty-message">
      No products available in this category yet.
    </p>

  <% end %>

</div>